# Database. Leave unset to use the SQLite file at backend/data/aq.db (zero setup).
# For PostgreSQL: pip install -e ".[postgres]" and use e.g.
# DATABASE_URL=postgresql+psycopg://aq:aq@localhost:5433/aq

# Live values come from Open-Meteo's air-quality API (CAMS model). No key or account needed.
# OPENMETEO_BATCH_SIZE=50   # cities per request
# OPENMETEO_PAST_DAYS=1     # each run also asks for yesterday, so a missed run is filled in

# Scrape hourly at this minute (IST) while the API is running, plus once at startup.
# The model publishes hours ahead, so a few minutes past the hour already has the new hour.
SCRAPER_ENABLED=true
SCRAPE_MINUTE=5
# Pause between the ~4 requests of each run
SCRAPER_REQUEST_DELAY_SECONDS=1.0
# Sent as the User-Agent header. Add a way to reach you, e.g. your email or the repo URL.
SCRAPER_USER_AGENT="envirocatalysts-aq-scraper/0.2 (air quality mobile app; hourly)"

# Values older than this are flagged stale and left out of the city ranking
LIVE_STALE_AFTER_HOURS=3
# Scraped readings older than this are deleted after each run
LIVE_RETENTION_DAYS=30

# Required by POST /v1/admin/scrape (sent as the X-Admin-Token header)
ADMIN_TOKEN=
