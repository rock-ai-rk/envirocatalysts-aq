# Database. Leave unset to use the SQLite file at backend/data/aq.db (zero setup).
# For PostgreSQL: pip install -e ".[postgres]" and use e.g.
# DATABASE_URL=postgresql+psycopg://aq:aq@localhost:5433/aq

# data.gov.in: register at https://data.gov.in, then My Account -> API key
DATAGOV_API_KEY=

# Scrape hourly at this minute (IST) while the API is running, plus once at startup.
# data.gov.in publishes each hour's values about 30 minutes past the hour.
SCRAPER_ENABLED=true
SCRAPE_MINUTE=40
# Pause between the ~4 pages of each fetch
SCRAPER_PAGE_DELAY_SECONDS=1.0
# Sent as the User-Agent header. Add a way to reach you, e.g. your email or the repo URL.
SCRAPER_USER_AGENT="envirocatalysts-aq-scraper/0.1 (air quality mobile app; hourly)"

# Readings older than this are flagged stale and left out of city averages
LIVE_STALE_AFTER_HOURS=3
# Scraped readings older than this are deleted after each run
LIVE_RETENTION_DAYS=30

# Required by POST /v1/admin/scrape (sent as the X-Admin-Token header)
ADMIN_TOKEN=
